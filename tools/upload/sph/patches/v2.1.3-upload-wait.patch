+    async fn check_upload_wait(stalled: bool) {
+        let Some(chrome) = test_chrome() else {
+            return;
+        };
+        let work = tempdir("upload-wait");
+        let profile = tempdir("upload-wait-browser");
+        let video = test_video_file(&work);
+        let (mut browser, page) = browser::launch(&chrome, &profile, false).await.unwrap();
+        let (mut opts, logs) = opts_with_fixture(FIXTURE_PUBLISH, video, None, true);
+        opts.navigate_url.as_mut().unwrap().push_str(if stalled {
+            "?uploadNeverCompletes=1"
+        } else {
+            "?uploadDelayMs=1800"
+        });
+        opts.timeout = if stalled {
+            Duration::from_millis(250)
+        } else {
+            Duration::from_secs(10)
+        };
+        let backend: Arc<dyn crate::publish::recovery::RecoveryBackend> =
+            Arc::new(crate::publish::recovery::NullBackend);
+        let result = crate::publish::mod_impl::run_inner_with_backend(
+            &work,
+            DEFAULT_ACCOUNT,
+            &page,
+            &DEFAULT_SELECTORS,
+            &opts,
+            &backend,
+        )
+        .await;
+        let value = page.evaluate("({previewVisible: !document.querySelector('.cover-preview-wrap').hidden, maskRemovedAt: window.maskRemovedAt, firstTitleInputAt: window.firstTitleInputAt, submits: window.submitCount, covers: window.coverUploads})")
+            .await.unwrap().into_value::<serde_json::Value>().unwrap();
+        assert_eq!(
+            value["previewVisible"], true,
+            "preview is already present while bytes are uploading"
+        );
+        assert_eq!(value["submits"], 0);
+        if stalled {
+            let err = result.unwrap_err();
+            assert_eq!(err.code, Code::Timeout);
+            assert_eq!(err.stage, Stage::Upload);
+            assert_eq!(value["maskRemovedAt"], 0);
+            assert_eq!(value["firstTitleInputAt"], 0);
+            assert!(value["covers"].as_object().unwrap().is_empty());
+            assert!(!String::from_utf8_lossy(&logs.lock().unwrap()).contains("步骤 2/5"));
+        } else {
+            assert!(!result.unwrap().submitted);
+            assert!(value["maskRemovedAt"].as_u64().unwrap() > 0);
+            assert!(
+                value["firstTitleInputAt"].as_u64().unwrap()
+                    >= value["maskRemovedAt"].as_u64().unwrap()
+            );
+        }
+        browser.close().await.unwrap();
     }
 
